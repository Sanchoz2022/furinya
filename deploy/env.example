# Ключи API для Furinya. Копируется на сервер как /opt/furinya/.env (chmod 600).
# НИКОГДА не коммитится.

# Mistral — чат-LLM (8b primary / 14b fallback), vision, эмбеддинги
MISTRAL_API_KEY=
# Groq — распознавание голосовых (whisper)
GROQ_API_KEY=
# Fish Audio — синтез голоса (клон)
FISH_API_KEY=
# AI Horde — запасной бэкенд генерации фото
FURINYA_HORDE_KEY=
# Адрес sd-server (stable-diffusion.cpp). В LXC рядом с генератором:
SD_API_URL=http://192.168.1.172:8082/
# Гасим болтовню TDLib в логах
FURINYA_TD_QUIET=1
